# Campus Job Posting System - Upload Security Lockdown
# Disable PHP and executable script execution within document and resume uploads

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|inc|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes -ExecCGI
