# ==============================================================================
# Dataset Seed Protection
#
# These fixtures are the source of truth for DatastoreManager::switchMode() and
# are re-imported into MySQL. They contain full user records, so they get the
# same denial as the rest of data/ - stated here explicitly so the protection
# survives any future change to the parent directory's rules.
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
