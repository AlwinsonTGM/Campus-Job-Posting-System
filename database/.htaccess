# ==============================================================================
# Database Directory Security Hardening
# Prevent direct browser access to SQL schemas, dumps, and logs
# ==============================================================================

# ==============================================================================
# Database Directory Security Hardening
# Prevent direct browser access to SQL schemas, dumps, migrations, and logs
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
